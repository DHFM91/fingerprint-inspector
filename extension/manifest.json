{
  "manifest_version": 3,
  "name": "Fingerprint Inspector",
  "author": "David Feuling",
  "homepage_url": "https://davidfeuling.com/fingerprint-inspector/",
  "version": "1.2.0",
  "description": "See what browser fingerprint you give off and which fingerprinting techniques each site uses. Estimates only; all data stays on your computer.",
  "permissions": ["storage", "downloads"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["shared.js", "background.js"]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Fingerprint Inspector",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["detector.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["relay.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["shared.js", "collector.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "fingerprint-inspector@local",
      "strict_min_version": "128.0"
    }
  }
}
